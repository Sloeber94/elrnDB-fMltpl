[[3,63,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Push the clutch release lever and remove the clutch release bearing\nfrom the gearbox input shaft.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2034697.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[3,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Fit the clutch release bearing\non the main shaft.</p><p>Pull the clutch release lever, engaging\nthe clutch release bearing in its seat.</p>"]]