[[3,47,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the cover.</p><p>2. Undo the bolts fixing the lamp.</p><p>3. Move the lamp and disconnect the electrical connection.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>3</p></td><td><p>Left main beam</p></td><td colspan=\"1\"><p><a href=\"#/2890286\">F12</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>3</p></td><td><p>Right main beam</p></td><td colspan=\"1\"><p><a href=\"#/2890289\">F13</a></p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2035432.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[3,47,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the lamp is not\ndamaged.</p><p>Connect the electrical connection and refit\nthe lamp.</p><p>Tighten the nut fixing the lamp.</p><p>Fit the cover.</p><p>If necessary, \n                                          <a href=\"#/2891930\">5540B37</a></p>"]]