[[1,63,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the retaining nut.</p><p>2. Remove the mobile tensioning device.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2033924.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Fit the mobile tensioning device.</p><p>Tighten the retaining nut.</p>"],[2,63,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Unscrew the retaining nut.</p><p>2. Remove the mobile  timing belt tensioner.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2034101.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Fit the mobile timing belt tensioner.</p><p>Screw in the retaining nut without tightening.</p>"]]