[[1,63,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the retaining nuts.</p><p>2. Remove the rear camshaft cover.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2033930.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Remove the gasket from the rear cover.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2033931.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,63,0,"<p>Fit the rear cover onto the cylinder head\nextension and tighten the retaining nuts to the specified torque.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001243.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th><th colspan=\"1\"><p>Value</p><p>(daNm)</p></th></tr><tr><td><p>-</p></td><td><p>Nut</p></td><td><p>INTAKE AND EXHAUST CAMSHAFT REAR COVER</p></td><td><p>M6</p></td><td colspan=\"1\"><p>0.9</p></td></tr></table></div>"]]