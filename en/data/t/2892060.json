[[3,63,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the switch unit.</p><p>2. Disconnect the electrical connection.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Adjustable mirror control</p></td><td colspan=\"1\"><p><a href=\"#/2890375\">H30</a></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Adjustable / folding mirrors control</p></td><td colspan=\"1\"><p><a href=\"#/2890377\">H31</a></p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2035568.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[3,63,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Check that the switch unit\nis undamaged.</p><p>If necessary, conduct an electrical test\non the switches.</p><p>Connect the electrical connection.</p><p>Fit the switch unit.</p><p>Check that the door mirrors are working\nproperly.</p>"]]